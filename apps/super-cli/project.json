{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "super-cli",
  "projectType": "application",
  "sourceRoot": "apps/super-cli/super_cli",
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run python -m super_cli.main",
        "cwd": "apps/super-cli"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff check .",
        "cwd": "apps/super-cli"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff format --check .",
        "cwd": "apps/super-cli"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run pyright",
        "cwd": "apps/super-cli"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run pytest",
        "cwd": "apps/super-cli"
      }
    },
    "test:unit:watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ptw .",
        "cwd": "apps/super-cli"
      }
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx typecheck super-cli",
          "npx nx lint super-cli",
          "npx nx test:unit super-cli"
        ],
        "cwd": ".",
        "parallel": false
      }
    }
  }
}
